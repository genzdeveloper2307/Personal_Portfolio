# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE (MongoDB Atlas or local MongoDB)
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio?retryWrites=true&w=majority

# ==========================================
# FRONTEND (used for CORS)
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# JWT AUTH
# ==========================================
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ==========================================
# ADMIN LOGIN
# (Generate ADMIN_PASSWORD_HASH with: npm run generate:admin-hash)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# EMAIL (SMTP) — optional, contact form still
# works and saves to MongoDB even if this is
# left empty
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER=
